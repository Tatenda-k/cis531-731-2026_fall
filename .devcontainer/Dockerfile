# ==============================================================================
# CIS 531/731: Minimal DevContainer Dockerfile (MP2)
# ==============================================================================
# BASE_IMAGE/BASE_TYPE are supplied by docker-compose.yml, which reads them
# from .devcontainer/.env. That file is generated by detect-gpu.sh (run via
# devcontainer.json's initializeCommand) so the right image is picked
# automatically: a CUDA-enabled PyTorch image when an NVIDIA GPU is present
# on the host, otherwise the plain CPU-only Python image.
ARG BASE_IMAGE=python:3.10-slim-bookworm
FROM ${BASE_IMAGE}

ARG BASE_TYPE=cpu

# 1. Install System Dependencies (Java for PySpark, FFmpeg for Whisper)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    openjdk-17-jre-headless \
    ffmpeg \
    git \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# 2. Configure Environment Variables
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PYSPARK_PYTHON=python3
ENV PIP_NO_CACHE_DIR=1

# 3. Install Python Dependencies (Strict Pinned Versions per MP2 Manifest)
RUN pip install --upgrade pip "setuptools<81"

# GPU images (pytorch/pytorch:*-cuda*) already ship a matching CUDA-enabled
# torch build, so only install torch explicitly for the CPU image.
RUN if [ "$BASE_TYPE" = "cpu" ]; then \
        pip install torch==2.2.1 --index-url https://download.pytorch.org/whl/cpu; \
    fi

RUN pip install \
    pyspark==3.5.1 \
    transformers==4.38.2 \
    mlflow==2.11.1 && \
    pip install --no-build-isolation openai-whisper==20231117

# faiss has separate CPU/GPU wheels.
RUN if [ "$BASE_TYPE" = "gpu" ]; then \
        pip install faiss-gpu==1.7.2; \
    else \
        pip install faiss-cpu==1.8.0; \
    fi

# 4. Create Non-Root User (Required for standard DevContainer permissions)
ARG USERNAME=vscode
ARG USER_UID=1000
ARG USER_GID=$USER_UID
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME -s /bin/bash \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

USER $USERNAME
WORKDIR /workspace
